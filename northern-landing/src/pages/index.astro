---
import { getCollection } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) =>
  new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
const featuredPosts = sortedPosts.slice(0, 3);

const categories = [
  { num: '01', title: 'Housing & Rentals', desc: 'Find your first apartment, understand rental agreements, and navigate the Canadian housing market with confidence.' },
  { num: '02', title: 'Jobs & Careers', desc: 'Discover how to get your credentials recognized, build a Canadian resume, and land your first job.' },
  { num: '03', title: 'Healthcare', desc: 'Learn how to register for provincial health coverage, find a family doctor, and access medical services.' },
  { num: '04', title: 'Language & Education', desc: 'Access free language classes, ESL programs, and educational pathways for you and your family.' },
  { num: '05', title: 'Banking & Money', desc: 'Open your first Canadian bank account, build credit history, and manage your finances effectively.' },
  { num: '06', title: 'Community & Culture', desc: 'Connect with cultural associations, community events, and people who share your background.' },
];

const quizFeatures = ['400+ practice questions', 'Real exam format', 'Progress tracking'];

const quizChoices = [
  { letter: 'A', text: 'Monarchy without representation', selected: false },
  { letter: 'B', text: 'Rule of law and equal rights', selected: true },
  { letter: 'C', text: 'Single-party governance', selected: false },
  { letter: 'D', text: 'Regional autonomy only', selected: false },
];

const placeholderStories = [
  { cat: 'Housing', title: 'Finding My First Apartment in Toronto as a Newcomer', excerpt: 'What nobody tells you about the rental market — and how I finally landed a place in six weeks.' },
  { cat: 'Jobs & Careers', title: 'Getting My Engineering Credentials Recognized in Canada', excerpt: 'A step-by-step account of the credential recognition process from someone who lived it.' },
  { cat: 'Community', title: 'Building a Support Network When You Know Nobody', excerpt: "From showing up alone to finding a community that felt like home — here's what worked." },
];
---

<BlogLayout
  title="Northern Landing - Your Journey to Canada Starts Here"
  description="Welcome to Northern Landing, your comprehensive resource hub for newcomers to Canada. Discover success stories, immigration guides, settlement tips, and community support to help you build your new life in Canada."
>

  <!-- ============================================================ -->
  <!-- HERO SECTION                                                   -->
  <!-- ============================================================ -->
  <section class="relative bg-[#0B0B0B] overflow-hidden">
    <!-- Cyan blob -->
    <div
      class="absolute right-0 top-1/2 -translate-y-1/2 w-[520px] h-[520px] rounded-full opacity-80 pointer-events-none"
      style="background: radial-gradient(circle, #00D9D9 0%, #00B5B5 50%, transparent 80%); transform: translate(40%, -50%);"
      aria-hidden="true"
    ></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <!-- Left: text -->
        <div>
          <!-- Eyebrow -->
          <div class="flex items-center gap-3 mb-6">
            <span class="block w-8 h-0.5 bg-[#CC2936]"></span>
            <span class="text-[#CC2936] text-xs font-semibold uppercase tracking-widest">New to Canada &middot; Start Here</span>
          </div>

          <h1 class="text-5xl lg:text-6xl font-black text-white leading-tight mb-6 tracking-tight">
            Welcome to <span class="text-[#CC2936]">Canada.</span><br />
            Let&rsquo;s build your<br />new home.
          </h1>

          <p class="text-gray-400 text-lg leading-relaxed mb-10 max-w-lg">
            Northern Landing is a free, community-built resource hub that helps newcomers navigate housing, jobs, healthcare, and more &mdash; so you can focus on building your life.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 mb-14">
            <a
              href="/blog"
              class="inline-flex items-center justify-center gap-2 bg-[#CC2936] text-white px-7 py-3 rounded-lg font-semibold text-sm hover:bg-red-800 transition-colors"
            >
              Explore Resources &rarr;
            </a>
            <a
              href="/blog?category=success-story"
              class="inline-flex items-center justify-center gap-2 border border-gray-600 text-white px-7 py-3 rounded-lg font-semibold text-sm hover:bg-white hover:bg-opacity-10 transition-colors"
            >
              Read Success Stories
            </a>
          </div>

          <!-- Stat bar -->
          <div class="flex flex-col sm:flex-row gap-6 sm:gap-0">
            <div class="sm:pr-8 sm:border-r sm:border-gray-700">
              <p class="text-2xl font-black text-gray-200">12,000+</p>
              <p class="text-gray-500 text-xs mt-0.5">Newcomers guided</p>
            </div>
            <div class="sm:px-8 sm:border-r sm:border-gray-700">
              <p class="text-2xl font-black text-gray-200">200+</p>
              <p class="text-gray-500 text-xs mt-0.5">Vetted resources</p>
            </div>
            <div class="sm:pl-8">
              <p class="text-2xl font-black text-gray-200">Free</p>
              <p class="text-gray-500 text-xs mt-0.5">Always, for everyone</p>
            </div>
          </div>
        </div>

        <!-- Right: image placeholder -->
        <div class="hidden lg:block">
          <div
            class="w-full rounded-2xl overflow-hidden flex items-center justify-center"
            style="aspect-ratio: 4/5; background: repeating-linear-gradient(135deg, #E8EDF0 0px, #E8EDF0 1px, #F0F4F7 1px, #F0F4F7 20px);"
          >
            <span class="border border-gray-400 text-gray-500 text-xs font-mono px-4 py-1 rounded-full" style="background: rgba(255,255,255,0.6);">
              newcomer / community photo &mdash; 4:5
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- START HERE SECTION                                             -->
  <!-- ============================================================ -->
  <section class="bg-white py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section header -->
      <div class="mb-14">
        <div class="flex items-center gap-3 mb-4">
          <span class="block w-8 h-0.5 bg-[#CC2936]"></span>
          <span class="text-[#CC2936] text-xs font-semibold uppercase tracking-widest">Start Here</span>
        </div>
        <h2 class="text-4xl lg:text-5xl font-black text-[#1A1A1A] leading-tight tracking-tight mb-4">
          Everything you need,<br />organized by what matters first.
        </h2>
        <p class="text-[#555555] text-lg max-w-2xl">
          We&rsquo;ve curated the most important resources for newcomers and organized them into six essential categories so you know exactly where to start.
        </p>
      </div>

      <!-- 6 category cards -->
      <div class="space-y-4">
        {categories.map((item) => (
          <div class="flex items-start gap-6 p-6 rounded-xl border border-[#E5E5E5] hover:shadow-sm transition-all group">
            <span class="bg-red-50 text-[#CC2936] font-mono text-sm font-bold px-3 py-2 rounded-lg inline-block flex-shrink-0">
              {item.num}
            </span>
            <div class="flex-1 min-w-0">
              <h3 class="text-[#1A1A1A] font-bold text-lg mb-1">{item.title}</h3>
              <p class="text-[#555555] text-sm leading-relaxed">{item.desc}</p>
            </div>
            <a
              href="/blog"
              class="text-[#CC2936] text-sm font-semibold flex-shrink-0 hidden sm:block"
            >
              Explore &rarr;
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- QUIZAPP CTA SECTION                                            -->
  <!-- ============================================================ -->
  <section class="bg-[#0B0B0B] py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <!-- Left: text -->
        <div>
          <div class="flex items-center gap-3 mb-6">
            <span class="block w-8 h-0.5 bg-[#CC2936]"></span>
            <span class="text-[#CC2936] text-xs font-semibold uppercase tracking-widest">Citizenship Test Prep</span>
          </div>

          <h2 class="text-4xl lg:text-5xl font-black text-white leading-tight tracking-tight mb-5">
            Ready to become a citizen?<br />
            Practice with<br />
            <span class="text-[#CC2936]">QuizApp.</span>
          </h2>

          <p class="text-gray-400 text-base leading-relaxed mb-8">
            Our free citizenship test prep tool covers every topic on the official exam. Practice at your own pace, track your progress, and walk into the test room confident.
          </p>

          <!-- Feature checkmarks -->
          <ul class="space-y-3 mb-10">
            {quizFeatures.map((feature) => (
              <li class="flex items-center gap-3 text-gray-300 text-sm">
                <span class="w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0" style="background: rgba(204,41,54,0.15); border: 1px solid rgba(204,41,54,0.4);">
                  <svg class="w-3 h-3 text-[#CC2936]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                  </svg>
                </span>
                {feature}
              </li>
            ))}
          </ul>

          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="#"
              class="inline-flex items-center justify-center gap-2 bg-[#CC2936] text-white px-7 py-3 rounded-lg font-semibold text-sm hover:bg-red-800 transition-colors"
            >
              Try QuizApp &rarr;
            </a>
            <a
              href="#"
              class="inline-flex items-center justify-center gap-2 border border-gray-700 text-gray-300 px-7 py-3 rounded-lg font-semibold text-sm hover:border-gray-500 hover:text-white transition-colors"
            >
              Take a free practice test
            </a>
          </div>
        </div>

        <!-- Right: mock quiz card -->
        <div class="flex justify-center lg:justify-end">
          <div class="bg-white rounded-2xl shadow-2xl p-7 w-full max-w-sm">
            <div class="flex items-center justify-between mb-5">
              <span class="text-xs font-bold uppercase tracking-widest text-gray-500">Practice Test</span>
              <span class="text-xs font-mono text-gray-500">12 / 20</span>
            </div>

            <!-- Progress bar -->
            <div class="w-full h-1.5 bg-gray-100 rounded-full mb-6 overflow-hidden">
              <div class="h-full bg-[#CC2936] rounded-full" style="width: 60%"></div>
            </div>

            <p class="text-[#1A1A1A] font-semibold text-sm leading-snug mb-5">
              Which of the following is a core principle of Canadian democracy?
            </p>

            <!-- Answer choices -->
            <div class="space-y-2">
              {quizChoices.map((choice) => (
                <div
                  class={choice.selected
                    ? "flex items-center gap-3 px-4 py-2 rounded-lg border text-sm border-[#CC2936] bg-red-50 text-[#CC2936] font-semibold"
                    : "flex items-center gap-3 px-4 py-2 rounded-lg border text-sm border-gray-200 text-gray-600"}
                >
                  <span
                    class={choice.selected
                      ? "w-6 h-6 rounded flex items-center justify-center text-xs font-bold flex-shrink-0 bg-[#CC2936] text-white"
                      : "w-6 h-6 rounded flex items-center justify-center text-xs font-bold flex-shrink-0 bg-gray-100 text-gray-500"}
                  >
                    {choice.letter}
                  </span>
                  {choice.text}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- FEATURED STORIES SECTION                                       -->
  <!-- ============================================================ -->
  <section class="bg-[#F9F7F4] py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section header -->
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 mb-14">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="block w-8 h-0.5 bg-[#CC2936]"></span>
            <span class="text-[#CC2936] text-xs font-semibold uppercase tracking-widest">Featured Stories</span>
          </div>
          <h2 class="text-4xl lg:text-5xl font-black text-[#1A1A1A] leading-tight tracking-tight mb-3">
            Real journeys,<br />honestly told.
          </h2>
          <p class="text-[#555555] text-base max-w-xl">
            Stories from newcomers across Canada &mdash; unfiltered, first-person accounts of finding your footing in a new country.
          </p>
        </div>
        <a
          href="/blog"
          class="inline-flex items-center gap-2 border border-gray-300 text-[#1A1A1A] px-6 py-2 rounded-lg text-sm font-semibold hover:border-[#CC2936] hover:text-[#CC2936] transition-colors self-start sm:self-auto flex-shrink-0"
        >
          View all stories &rarr;
        </a>
      </div>

      <!-- Story cards from CMS -->
      {featuredPosts.length > 0 && (
        <div class="space-y-8">
          {featuredPosts.map((post) => (
            <article class="bg-white rounded-2xl border border-[#E5E5E5] overflow-hidden hover:shadow-md transition-shadow">
              <div class="grid grid-cols-1 md:grid-cols-5 gap-0">
                <!-- Image placeholder -->
                <div
                  class="md:col-span-2 min-h-48 flex items-center justify-center"
                  style="background: repeating-linear-gradient(135deg, #E8EDF0 0px, #E8EDF0 1px, #F0F4F7 1px, #F0F4F7 20px);"
                >
                  <span class="border border-gray-400 text-gray-500 text-xs font-mono px-3 py-1 rounded-full" style="background: rgba(255,255,255,0.6);">
                    story photo &mdash; 16:10
                  </span>
                </div>
                <!-- Content -->
                <div class="md:col-span-3 p-7 flex flex-col justify-between">
                  <div>
                    <div class="flex items-center gap-3 mb-3">
                      <span class="bg-red-50 text-[#CC2936] text-xs font-medium px-3 py-1 rounded-full">
                        {post.data.category}
                      </span>
                      <span class="text-gray-400 text-xs">
                        {new Date(post.data.pubDate).toLocaleDateString('en-CA', {
                          month: 'short',
                          day: 'numeric',
                          year: 'numeric'
                        })}
                      </span>
                    </div>
                    <h3 class="text-[#1A1A1A] font-bold text-xl mb-2 line-clamp-2">{post.data.title}</h3>
                    <p class="text-[#555555] text-sm leading-relaxed line-clamp-3 mb-5">{post.data.description}</p>
                  </div>
                  <a
                    href={`/blog/${post.slug}`}
                    class="text-[#1A1A1A] text-sm font-mono font-semibold hover:text-[#CC2936] transition-colors self-start"
                  >
                    Read story &rarr;
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}

      <!-- Placeholder story cards when no CMS posts -->
      {featuredPosts.length === 0 && (
        <div class="space-y-8">
          {placeholderStories.map((item) => (
            <article class="bg-white rounded-2xl border border-[#E5E5E5] overflow-hidden hover:shadow-md transition-shadow">
              <div class="grid grid-cols-1 md:grid-cols-5 gap-0">
                <div
                  class="md:col-span-2 min-h-48 flex items-center justify-center"
                  style="background: repeating-linear-gradient(135deg, #E8EDF0 0px, #E8EDF0 1px, #F0F4F7 1px, #F0F4F7 20px);"
                >
                  <span class="border border-gray-400 text-gray-500 text-xs font-mono px-3 py-1 rounded-full" style="background: rgba(255,255,255,0.6);">
                    story photo &mdash; 16:10
                  </span>
                </div>
                <div class="md:col-span-3 p-7 flex flex-col justify-between">
                  <div>
                    <div class="flex items-center gap-3 mb-3">
                      <span class="bg-red-50 text-[#CC2936] text-xs font-medium px-3 py-1 rounded-full">{item.cat}</span>
                      <span class="text-gray-400 text-xs">Jan 15, 2026</span>
                    </div>
                    <h3 class="text-[#1A1A1A] font-bold text-xl mb-2">{item.title}</h3>
                    <p class="text-[#555555] text-sm leading-relaxed mb-5">{item.excerpt}</p>
                  </div>
                  <a href="/blog" class="text-[#1A1A1A] text-sm font-mono font-semibold hover:text-[#CC2936] transition-colors self-start">
                    Read story &rarr;
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

</BlogLayout>
