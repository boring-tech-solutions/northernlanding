---
import { getCollection } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => 
  new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
---

<BlogLayout 
  title="Blog - Success Stories & Resources for Newcomers to Canada"
  description="Read inspiring success stories, immigration tips, and settlement guides from newcomers who have built successful lives in Canada."
>
  <div class="py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="mb-14">
        <div class="flex items-center gap-3 mb-4">
          <span class="block w-8 h-0.5 bg-[#CC2936]"></span>
          <span class="text-[#CC2936] text-xs font-semibold uppercase tracking-widest">SUCCESS STORIES</span>
        </div>
        <h1 class="text-4xl lg:text-5xl font-black tracking-tight text-[#1A1A1A] leading-tight mb-4">
          Success Stories & Resources
        </h1>
        <p class="text-[#555555] text-lg max-w-2xl">
          Real experiences, expert advice, and practical tips from newcomers who have successfully built their lives in Canada.
        </p>
      </div>

      <!-- Featured Post -->
      {sortedPosts.length > 0 && (
        <div class="mb-16">
          <h2 class="text-2xl font-black tracking-tight text-[#1A1A1A] mb-6">Featured Story</h2>
          <div class="bg-[#0B0B0B] rounded-2xl p-8 text-white">
            <div class="max-w-4xl">
              <div class="flex items-center mb-4">
                <span class="bg-[#CC2936] text-white px-3 py-1 rounded-full text-sm font-semibold">
                  Featured
                </span>
                <span class="ml-4 text-gray-400">
                  {new Date(sortedPosts[0].data.pubDate).toLocaleDateString('en-CA', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </span>
              </div>
              <h3 class="text-3xl font-black tracking-tight mb-4">{sortedPosts[0].data.title}</h3>
              <p class="text-xl text-gray-400 mb-6">{sortedPosts[0].data.description}</p>
              <a
                href={`/blog/${sortedPosts[0].slug}`}
                class="inline-block bg-[#CC2936] text-white px-7 py-3 rounded-lg font-semibold text-sm hover:bg-red-800 transition-colors"
              >
                Read Full Story
              </a>
            </div>
          </div>
        </div>
      )}

      <!-- Blog Posts Grid -->
      <div class="mb-12">
        <h2 class="text-3xl md:text-4xl font-black tracking-tight text-[#1A1A1A] mb-6">All Stories</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {sortedPosts.map((post) => (
            <article class="bg-white rounded-2xl border border-[#E5E5E5] overflow-hidden hover:shadow-md transition-shadow">
              <div class="p-6">
                <div class="flex items-center mb-3">
                  <span class="bg-red-50 text-[#CC2936] text-xs font-medium px-3 py-1 rounded-full">
                    {post.data.category}
                  </span>
                  <span class="ml-3 text-gray-400 text-xs">
                    {new Date(post.data.pubDate).toLocaleDateString('en-CA', {
                      month: 'short',
                      day: 'numeric',
                      year: 'numeric'
                    })}
                  </span>
                </div>
                <h3 class="text-xl font-bold text-[#1A1A1A] mb-3 line-clamp-2">
                  {post.data.title}
                </h3>
                <p class="text-[#555555] text-sm leading-relaxed mb-4 line-clamp-3">
                  {post.data.description}
                </p>
                <div class="flex items-center justify-between">
                  <a
                    href={`/blog/${post.slug}`}
                    class="text-[#1A1A1A] text-sm font-mono font-semibold hover:text-[#CC2936] transition-colors"
                  >
                    Read More →
                  </a>
                  <div class="flex items-center text-gray-400 text-sm">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    {post.data.readTime || '5'} min read
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>

      <!-- Categories -->
      <div class="bg-white border border-[#E5E5E5] rounded-2xl p-8">
        <h2 class="text-2xl font-black tracking-tight text-[#1A1A1A] mb-6">Browse by Category</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <a href="/blog?category=immigration" class="bg-white p-4 rounded-xl border border-[#E5E5E5] text-center hover:border-[#CC2936] transition-colors">
            <div class="text-2xl mb-2">🛂</div>
            <h3 class="font-semibold text-[#1A1A1A]">Immigration</h3>
            <p class="text-sm text-[#555555]">Visa & permits</p>
          </a>
          <a href="/blog?category=settlement" class="bg-white p-4 rounded-xl border border-[#E5E5E5] text-center hover:border-[#CC2936] transition-colors">
            <div class="text-2xl mb-2">🏠</div>
            <h3 class="font-semibold text-[#1A1A1A]">Settlement</h3>
            <p class="text-sm text-[#555555]">Getting started</p>
          </a>
          <a href="/blog?category=work" class="bg-white p-4 rounded-xl border border-[#E5E5E5] text-center hover:border-[#CC2936] transition-colors">
            <div class="text-2xl mb-2">💼</div>
            <h3 class="font-semibold text-[#1A1A1A]">Work & Career</h3>
            <p class="text-sm text-[#555555]">Job search tips</p>
          </a>
          <a href="/blog?category=community" class="bg-white p-4 rounded-xl border border-[#E5E5E5] text-center hover:border-[#CC2936] transition-colors">
            <div class="text-2xl mb-2">🤝</div>
            <h3 class="font-semibold text-[#1A1A1A]">Community</h3>
            <p class="text-sm text-[#555555]">Building connections</p>
          </a>
        </div>
      </div>

      <!-- Newsletter Signup -->
      <div class="mt-16 bg-[#0B0B0B] rounded-2xl p-8 text-white text-center">
        <h2 class="text-2xl font-black tracking-tight mb-4">Stay Updated</h2>
        <p class="text-gray-400 mb-6 max-w-2xl mx-auto">
          Get the latest success stories, immigration updates, and settlement tips delivered to your inbox.
        </p>
        <div class="max-w-md mx-auto flex flex-col sm:flex-row gap-4">
          <input
            type="email"
            placeholder="Enter your email"
            class="flex-1 px-4 py-4 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-[#CC2936]"
          />
          <button class="w-full sm:w-auto bg-[#CC2936] text-white px-6 py-4 rounded-lg font-semibold hover:bg-red-800 transition-colors">
            Subscribe
          </button>
        </div>
      </div>
    </div>
  </div>
</BlogLayout>
