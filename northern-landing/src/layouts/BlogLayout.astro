---
import Header from '../components/Header.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonical?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  author?: string;
}

const {
  title = "Northern Landing - Resources for Newcomers to Canada",
  description = "A comprehensive blog and resource hub for newcomers to Canada, featuring immigration stories, settlement guides, and community support.",
  image = "/og-image.png",
  imageAlt = "Northern Landing - Welcome to Canada. Let's build your new home.",
  canonical = new URL(Astro.url.pathname, Astro.site).href,
  type = 'website',
  publishedTime,
  author,
} = Astro.props;

// Social crawlers require absolute URLs for og:image / twitter:image
const imageUrl = new URL(image, Astro.site).href;

const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Northern Landing",
  "description": "A comprehensive blog and resource hub for newcomers to Canada",
  "url": Astro.site?.href,
  "logo": new URL('/og-image.png', Astro.site).href,
});
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonical} />

    <!-- Open Graph (https://ogp.me/) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Northern Landing" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {type === 'article' && author && <meta property="article:author" content={author} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Structured Data -->
    <script type="application/ld+json" is:inline set:html={structuredData} />
  </head>
  <body class="min-h-screen bg-[#F9F7F4]">
    <Header />

    <main class="min-h-screen">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-[#E5E5E5]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
          <!-- Brand column -->
          <div class="md:col-span-1">
            <a href="/" class="flex items-center gap-3 mb-4">
              <div class="w-8 h-8 bg-[#CC2936] rounded-lg flex items-center justify-center flex-shrink-0">
                <span class="text-white font-black text-sm leading-none">N</span>
              </div>
              <span class="text-[#1A1A1A] font-bold text-lg tracking-tight">Northern Landing</span>
            </a>
            <p class="text-gray-500 text-sm leading-relaxed max-w-xs">
              Built for newcomers to Canada — free resources, real stories, and community support for every step of your journey.
            </p>
          </div>

          <!-- Resources column -->
          <div>
            <h4 class="text-xs font-semibold uppercase tracking-widest text-[#1A1A1A] mb-4">Resources</h4>
            <ul class="space-y-3">
              <li><a href="/blog?category=housing" class="text-gray-500 hover:text-[#CC2936] text-sm transition-colors">Housing &amp; Rentals</a></li>
              <li><a href="/blog?category=jobs" class="text-gray-500 hover:text-[#CC2936] text-sm transition-colors">Jobs &amp; Careers</a></li>
              <li><a href="/blog?category=healthcare" class="text-gray-500 hover:text-[#CC2936] text-sm transition-colors">Healthcare</a></li>
              <li><a href="/blog?category=banking" class="text-gray-500 hover:text-[#CC2936] text-sm transition-colors">Banking &amp; Money</a></li>
            </ul>
          </div>

          <!-- Explore column -->
          <div>
            <h4 class="text-xs font-semibold uppercase tracking-widest text-[#1A1A1A] mb-4">Explore</h4>
            <ul class="space-y-3">
              <li><a href="/blog?category=success-story" class="text-gray-500 hover:text-[#CC2936] text-sm transition-colors">Success Stories</a></li>
              <li><a href="https://quizapp.ca" target="_blank" rel="noopener noreferrer" class="text-gray-500 hover:text-[#CC2936] text-sm transition-colors">Citizenship Test</a></li>
              <li><a href="/about" class="text-gray-500 hover:text-[#CC2936] text-sm transition-colors">About Us</a></li>
              <li><a href="/contact" class="text-gray-500 hover:text-[#CC2936] text-sm transition-colors">Contact</a></li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Bottom bar -->
      <div class="border-t border-[#E5E5E5]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 flex flex-col sm:flex-row justify-between items-center gap-4">
          <p class="text-gray-400 text-sm">
            &copy; 2026 Northern Landing. Built for newcomers, by newcomers.
          </p>
          <div class="flex items-center gap-3">
            <!-- Instagram -->
            <a href="#" aria-label="Instagram" class="w-8 h-8 rounded-full border border-[#E5E5E5] flex items-center justify-center text-gray-400 hover:text-[#CC2936] hover:border-[#CC2936] transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
            <!-- YouTube -->
            <a href="#" aria-label="YouTube" class="w-8 h-8 rounded-full border border-[#E5E5E5] flex items-center justify-center text-gray-400 hover:text-[#CC2936] hover:border-[#CC2936] transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>
            <!-- @ / Email -->
            <a href="/contact" aria-label="Contact" class="w-8 h-8 rounded-full border border-[#E5E5E5] flex items-center justify-center text-gray-400 hover:text-[#CC2936] hover:border-[#CC2936] transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
